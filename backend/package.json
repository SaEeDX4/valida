{
  "name": "valida-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Valida backend API (Node.js + Express + JavaScript).",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:b1": "npm test && npm audit --audit-level=high",
    "test:db": "vitest run --config vitest.db.config.js",
    "test:s3": "vitest run --config vitest.s3.config.js",
    "test:coverage": "vitest run --coverage",
    "db:indexes:check": "node --env-file-if-exists=.env scripts/db-indexes.mjs check",
    "db:indexes:apply": "node --env-file-if-exists=.env scripts/db-indexes.mjs apply",
    "verify:b2": "node scripts/verify-b2.mjs",
    "jobs:provision:plan": "node --env-file-if-exists=.env scripts/provision-job.mjs plan",
    "jobs:provision:apply": "node --env-file-if-exists=.env scripts/provision-job.mjs apply",
    "verify:b3": "node scripts/verify-b3.mjs",
    "verify:b4": "node scripts/verify-b4.mjs",
    "verify:b5": "node scripts/verify-b5.mjs",
    "ops:notifications:retry": "node --env-file-if-exists=.env scripts/notifications-retry.mjs",
    "ops:notifications:smoke": "node --env-file-if-exists=.env scripts/notifications-smoke.mjs",
    "ops:notifications:suppression": "node --env-file-if-exists=.env scripts/ops-notifications-suppression.mjs",
    "ops:storage:reconcile": "node --env-file-if-exists=.env scripts/storage-reconcile.mjs",
    "ops:monitoring:test-event": "node --env-file-if-exists=.env scripts/monitoring-test-event.mjs",
    "ops:backup:copy": "node --env-file-if-exists=.env scripts/backup.mjs copy",
    "ops:backup:manifest": "node --env-file-if-exists=.env scripts/backup.mjs manifest",
    "ops:backup:delete-application": "node --env-file-if-exists=.env scripts/backup.mjs delete-application",
    "ops:backup:restore": "node --env-file-if-exists=.env scripts/backup.mjs restore",
    "test:backup": "vitest run --config vitest.backup.config.js",
    "test:mongo-roles": "vitest run --config vitest.roles.config.js",
    "test:recovery": "vitest run --config vitest.recovery.config.js",
    "test:scanner": "vitest run --config vitest.scanner.config.js",
    "ops:recovery:journal-init": "node scripts/mongo-recovery.mjs journal-init",
    "ops:recovery:delete-application": "node scripts/mongo-recovery.mjs delete-application",
    "ops:recovery:journal-head": "node scripts/mongo-recovery.mjs journal-head",
    "ops:recovery:journal-export": "node scripts/mongo-recovery.mjs journal-export",
    "ops:recovery:prepare-target": "node scripts/mongo-recovery.mjs prepare-target",
    "ops:recovery:restore-verify": "node scripts/mongo-recovery.mjs restore-verify",
    "ops:resume:scan": "node scripts/resume-scan.mjs",
    "verify:b6": "node scripts/verify-b6.mjs",
    "verify:b7": "node scripts/verify-b7.mjs",
    "admin:provision": "node --env-file-if-exists=.env scripts/admin-provision.mjs"
  },
  "dependencies": {
    "@fastify/busboy": "^3.2.2",
    "@sentry/core": "11.10.0",
    "connect-mongo": "6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "1.19.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.4",
    "nodemailer": "10.1.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.3",
    "smtp-server": "3.19.24",
    "supertest": "^7.3.0",
    "vite": "8.3.3",
    "vitest": "^5.0.3"
  }
}
