{
  "name": "valida-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Valida backend API (Node.js + Express + JavaScript).",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:b1": "npm test && npm audit --audit-level=high",
    "test:db": "vitest run --config vitest.db.config.js",
    "db:indexes:check": "node --env-file-if-exists=.env scripts/db-indexes.mjs check",
    "db:indexes:apply": "node --env-file-if-exists=.env scripts/db-indexes.mjs apply",
    "verify:b2": "node scripts/verify-b2.mjs",
    "jobs:provision:plan": "node --env-file-if-exists=.env scripts/provision-job.mjs plan",
    "jobs:provision:apply": "node --env-file-if-exists=.env scripts/provision-job.mjs apply",
    "verify:b3": "node scripts/verify-b3.mjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.10.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "supertest": "^7.3.0",
    "vitest": "^5.0.1"
  }
}
