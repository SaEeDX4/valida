diff --git a/backend/src/integrations/notifications/emailLogo.js b/backend/src/integrations/notifications/emailLogo.js
new file mode 100644
index 0000000..2b01b82
--- /dev/null
+++ b/backend/src/integrations/notifications/emailLogo.js
@@ -0,0 +1,41 @@
+import crypto from 'node:crypto';
+import fs from 'node:fs';
+
+/**
+ * The email logo — Milestone B6 Stage 2, integrated after the owner approved
+ * the specific derived file (see docs/qa/b6-stage2/logo/).
+ *
+ * The official dark horizontal lockup (frontend/public/brand/
+ * valida-logo-horizontal-dark.png, SHA-256 920db434…dc5e), resampled ONLY to
+ * 316 x 72 px and shown at 158 x 36 (Concept A specification section 7). It
+ * travels inline, as a CID related part: nothing is fetched from anywhere, so
+ * it cannot signal an open (Doc 14 section 138).
+ *
+ * The bytes are pinned: they are read once and must match the approved
+ * SHA-256, or composing the message fails (a defect, never a substitute
+ * image). The file name and Content-ID are constants and carry no candidate
+ * or Application data.
+ */
+export const EMAIL_LOGO = Object.freeze({
+  file: 'valida-logo-email-316x72.png',
+  sha256: 'b8c541749d0869f2473cc3344e6de5e8ecea9813bb106feb1fc3531602c8341a',
+  contentId: 'valida-logo.b6@cybervalida.com',
+  filename: 'valida-logo.png',
+  contentType: 'image/png',
+  width: 158,
+  height: 36,
+  alt: 'Valida',
+});
+
+let verifiedBytes = null;
+
+/** The approved logo bytes; throws if the asset is missing or does not match its approved hash. */
+export function emailLogoBytes() {
+  if (verifiedBytes) return verifiedBytes;
+  const bytes = fs.readFileSync(new URL(`./assets/${EMAIL_LOGO.file}`, import.meta.url));
+  if (crypto.createHash('sha256').update(bytes).digest('hex') !== EMAIL_LOGO.sha256) {
+    throw new Error('email logo asset does not match its approved SHA-256');
+  }
+  verifiedBytes = bytes;
+  return verifiedBytes;
+}
diff --git a/backend/src/integrations/notifications/smtpTransport.js b/backend/src/integrations/notifications/smtpTransport.js
index a81fcfc..0450f7a 100644
--- a/backend/src/integrations/notifications/smtpTransport.js
+++ b/backend/src/integrations/notifications/smtpTransport.js
@@ -4,6 +4,7 @@ import tls from 'node:tls';
 import { Readable } from 'node:stream';
 import SMTPConnection from 'nodemailer/lib/smtp-connection';
 import MailComposer from 'nodemailer/lib/mail-composer';
+import { EMAIL_LOGO, emailLogoBytes } from './emailLogo.js';
 
 /**
  * SMTP transport adapter — Milestone B6 r4.
@@ -62,6 +63,9 @@ import MailComposer from 'nodemailer/lib/mail-composer';
  * Message-ID derived from the idempotency key (the same for every attempt of
  * one logical message — a correlation aid, NOT an exactly-once guarantee),
  * Auto-Submitted: auto-generated (RFC 3834: no auto-replies), no X-Mailer.
+ * B6 Stage 2: an HTML part that references the approved email logo by its
+ * Content-ID gets that logo as ONE inline related part (fixed name and
+ * Content-ID, bytes pinned by SHA-256); nothing else is ever attached.
  * The envelope asks, where the server supports DSN (RFC 3461), for
  * failure/delay reports with headers only and an ENVID equal to the
  * Message-ID token, so a bounce can be matched without its content.
@@ -446,6 +450,7 @@ export function createSmtpTransport({
 
   /** The message, composed once, before any connection is opened. */
   async function compose(message, reference) {
+    const usesLogo = typeof message.html === 'string' && message.html.includes(`cid:${EMAIL_LOGO.contentId}`);
     const composer = new MailComposer({
       from: { name: message.from.name, address: message.from.address },
       to: message.to[0],
@@ -456,6 +461,19 @@ export function createSmtpTransport({
