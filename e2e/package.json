{
  "name": "valida-e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Valida critical browser E2E (Doc 17 sections 197-214; Doc 18 section 161): a production frontend build, the real Express backend, a disposable MongoDB database, private local storage and a local SMTP test server.",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:seo": "playwright test --config playwright.seo.config.js",
    "test:e2e:c5": "playwright test --config playwright.c5.config.js",
    "test:c5:stats": "node --test c5/perfStats.test.js",
    "test:c5:motion": "node --test c5/motionJudge.test.js",
    "test:c6:stack": "node c6/c6-t2-stack.mjs",
    "test:c6t3:stack": "node c6/c6-t3-stack.mjs",
    "test:c6t4:stack": "node c6/c6-t4-stack.mjs",
    "test:c6t5:stack": "node c6/c6-t5-stack.mjs",
    "test:c6t6:rehearsal": "node c6/c6-t6-backup-rehearsal.mjs",
    "test:c6t6:checker": "node c6/c6-t6-review-checker.mjs",
    "test:guards": "node --test guards/run-directory.test.js guards/loopback.test.js"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
