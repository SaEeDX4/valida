# ---------------------------------------------------------------------------
# Valida frontend — example environment file
#
# Copy this file to `.env` and fill in local values:
#   Windows PowerShell:  Copy-Item .env.example .env
#
# `.env` is git-ignored. `.env.example` is committed.
# Governed by 08_FRONTEND_SPEC.md sections 122-125 and
# 15_DEVOPS_DEPLOYMENT.md sections 51-53.
#
# SECURITY RULE (08_FRONTEND_SPEC.md section 124)
# Everything prefixed VITE_ is compiled into the browser bundle and is PUBLIC.
# Never place API secrets, storage credentials, the MongoDB URI or email
# provider secrets in this file.
# ---------------------------------------------------------------------------

# ORIGIN of the Valida backend — scheme, host and port only.
#
# The /api/v1 prefix is part of every request path in the feature API modules,
# so it must NOT be repeated here. Including it would produce
# http://localhost:4000/api/v1/api/v1/jobs.
#
# Leave this empty for a same-origin deployment: requests then resolve to
# /api/v1/jobs against the current origin. There is no fabricated production
# hostname.
#
# Local development example:
VITE_API_BASE_URL=http://localhost:4000

# Controlled A5 development fixtures (QA tooling only).
#
# When 'true' AND the app is running under `npm run dev`, synthetic Job and
# Application data replaces the real API so every Careers / Job Detail / Apply
# state can be reviewed before the backend exists.
#
# BOTH conditions are required. A production build can never activate this:
# import.meta.env.DEV is false there, so the branch is removed at build time.
# Fixtures are never activated by a failed request.
#
# Scenarios are selected with a ?a5=<scenario> query parameter, for example:
#   ?a5=jobs-empty   ?a5=jobs-error    ?a5=job-closed
#   ?a5=apply-success   ?a5=apply-network   ?a5=apply-serverfields
VITE_ENABLE_A5_FIXTURES=false

# Public origin of the Valida website, used for canonical URLs and metadata.
# Consumed from Milestone A4 onward.
# Local development example:
VITE_PUBLIC_SITE_URL=http://localhost:5173
